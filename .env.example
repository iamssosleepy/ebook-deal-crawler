# Optional. If set, crawler will post the beautified digest to Discord.
DISCORD_WEBHOOK_URL=

# Optional. Forum-channel webhooks only. If the webhook targets a Discord forum channel,
# either set DISCORD_THREAD_ID to post into an existing thread, or set DISCORD_THREAD_NAME
# to create a new thread per post. If neither is set and Discord returns code 220001
# (forum channel requires thread_name/thread_id), the crawler will retry once with a
# default thread name like "電子書特價日報 YYYY-MM-DD" (prefixed with "[測試] " when
# DISCORD_TEST_MODE=1). For normal text-channel webhooks, leave both unset.
DISCORD_THREAD_ID=
DISCORD_THREAD_NAME=

# Optional. If set, crawler writes rows into this Google Sheet.
# Production sheet: https://docs.google.com/spreadsheets/d/1rBnTmFgAjQYHvEjUxSZqG3yswLXD-keueIaGNRK6mJU/edit
GOOGLE_SHEET_ID=1rBnTmFgAjQYHvEjUxSZqG3yswLXD-keueIaGNRK6mJU

# Optional. JSON service account credentials, single-line escaped JSON.
# Required only when GOOGLE_SHEET_ID is set.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional. Default Asia/Taipei.
TZ=Asia/Taipei

# Optional. Set to 1 to skip posting/writing external integrations.
DRY_RUN=1

# Optional. Comma-separated source list.
# readmoo,kobo,booksTw,pubu
SOURCES=readmoo,kobo,booksTw,pubu

# Optional. Default worksheet tab name.
GOOGLE_SHEET_TAB=每日特價

# Optional. In CI, set to 1 to fail if Google/Discord secrets are missing.
REQUIRE_TARGETS=0

# Optional. Set to 1 to fail the whole workflow if one source errors.
FAIL_ON_SOURCE_ERROR=0

# Optional. Minimum normalized deals. Set to 0 to disable.
MIN_DEALS=10
